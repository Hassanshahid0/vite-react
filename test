// Local buffer for our records
let braggingQueue = [];

// Initial delay to start the loop
window.setTimeout(showBraggingToast, 5 * 1000);

function showBraggingToast() {
  // 1. Check if we have records in our local queue
  if (braggingQueue.length > 0) {
    // Pop the first record and display it
    const record = braggingQueue.shift();
    displayToast(record);
    
    // Schedule the next Toast in 30 seconds
    window.setTimeout(showBraggingToast, 30 * 1000);
  } else {
    // 2. Queue is empty, fetch a new batch of 10
    $.ajax({
      dataType: "json",
      url: window.location.origin + "/order/bragging_rights",
      success: function(resultObj) {
        if (resultObj.result === 500) {
          // No results found, stop the Toast altogether
        } else if (resultObj.result === 200 && Array.isArray(resultObj.data) && resultObj.data.length > 0) {
          // Fill the queue with the new batch
          braggingQueue = resultObj.data;
          
          // Immediately show the first one from the new batch
          const record = braggingQueue.shift();
          displayToast(record);

          // Schedule the next Toast in 30 seconds
          window.setTimeout(showBraggingToast, 30 * 1000);
        }
        
      },
      error: function() {
        // If the server fails, try again in 1 minute to be safe
        window.setTimeout(showBraggingToast, 60 * 1000);
      }
    });
  }
}

/**
 * Helper to handle the UI toast logic
 */
function displayToast(data) {
  if (typeof data === 'object' && typeof data.make === 'string' && $.toast) {
    $.toast({
      heading: data.year + ' ' + ucwords(data.make) + ' ' + ucwords(data.model),
      text: ucwords(data.fname) + ' ' + data.lname + ', just ordered an inspection on a ' + data.year + ', ' + ucwords(data.make) + ' ' + ucwords(data.model),
      icon: 'info',
      loader: true,
      loaderBg: '#9EC600',
      hideAfter: 10 * 1000
    });
  }
}

function ucwords(str) {
  return (str + '').replace(/^([a-z])|\s+([a-z])/g, function($1) {
    return $1.toUpperCase();
  });
}
