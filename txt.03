<div id="pomcar-login-modal" class="modal fade">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-body p-5">
				<div class="login-modal-logo mb-3 w-50">
					<img src="https://pomcar.com/wp-content/uploads/2015/02/logo-color.png">
				</div>
				<h4 class="login-modal-intro">Technician Sign In</h4>
				<div id="sf-login-modal-errors"></div>
				<form name="loginform" id="sf-ajax-login-form" action="https://pomcar.com/wp-login.php" method="post">

					<p class="login-username mb-0">
						<label></label>
						<input type="text"
								name="email"
								class="input user_login form-control"
								value=""
								size="20"
								placeholder="Email Address">
					</p>
					<p class="login-password">
						<label for="user_pass"></label>
						<input type="password"
								name="password"
								id="user_pass"
								class="input form-control"
								value=""
								size="20"
								placeholder="Password">
					</p>

					<p class="login-submit mb-3">
						<input type="submit"
								name="wp-submit"
								class="btn btn-primary button-primary wp-submit"
								value="Log In">
						<input type="hidden" name="redirect_to" value="">
					</p>
					<div class="login-remember mb-3">
						<label>
							<input class="form-check-input"
									name="rememberme"
									type="checkbox"
									id="rememberme"
									value="forever"> Remember Me
						</label>
						<a data-bs-target="#pomcar-forgot-password-modal"
							data-bs-toggle="modal"
							href="/wp-login.php?action=lostpassword">
							Forgot Password?
						</a>
					</div>
				</form>
				<div class="login-modal-footer">Not a member of the POMCAR Network? <br>
					<a href="/technician-registration">Apply Now</a></div>
			</div>
		</div>
	</div>
</div>
<script type="text/javascript">
	jQuery( document ).ready( function ( $ ) {
		$( 'form#sf-ajax-login-form' ).on( 'submit', function ( e ) {
			e.preventDefault();
			var datastring = $( this ).serialize();
			$.ajax( {
				type: "POST",
				url: "https://pomcar.com/wp-admin/admin-ajax.php?action=sf_ajax_login",
				data: datastring,
				dataType: "json",
				success: function ( data ) {
					if ( data.error ) {
						jQuery( '#sf-login-modal-errors' ).html( '<div class="login-modal-errors">' + data.error + '</div>' );
					}
					if ( data.success ) {
						if ( data.redirect ) {
							window.location = data.redirect;
						} else {
							window.location.reload();
						}

					}
				},
				error: function () {
					alert( 'Login ajax error.' );
				}
			} );
			return false;
		} );

	} );
</script>
		
