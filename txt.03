					</div>

					<p class="login-submit">
						<input type="submit" name="wp-submit" class="btn btn-primary button-primary wp-submit g-recaptcha" 
														data-sitekey="6LdMA5IrAAAAAHEfTqrNzeDZ8zYQc6ecVCchuk-5" 
							data-callback="onSubmitForgotPassword" 
							data-size="invisible"
